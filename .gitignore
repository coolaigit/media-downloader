# ============================================================
#  绝不入库：体积大 / 可再生成 / 与本机环境绑定
#
#  背景：本项目代码本体只有约 1 MB，其余 5.4 GB 全是下面这些。
#  配好这个文件，git 仓库（含全部历史）也只会有几 MB。
#  ⚠️ 改动本文件前请先确认不会把大目录放进来 —— 一旦 add 进历史很难清除。
# ============================================================

# ---- 下载下来的媒体（实测 5220 MB，最大头）----
downloads/
scanned/

# ---- 运行时依赖与随包二进制（约 220 MB）----
_pylibs/
_wheel/
bin/
.playwright-mcp/

# ---- V3.0 内置 Playwright Chromium（约 430 MB，构建时下载，绝不入库）----
# 下载命令（源码目录下执行）：
#   set PLAYWRIGHT_BROWSERS_PATH=%CD%\browsers
#   python -m playwright install chromium
# 装完删掉 chromium_headless_shell-* / ffmpeg-* / winldd-* 可省 275MB，
# 程序会用完整内核跑 headless（必须传 executable_path，见 app/browser_runtime.py）
browsers/

# ---- 抓取样本数据（可重新抓取）----
_probe_data/

# ---- 临时诊断产物 ----
# 本项目约定：下划线开头的都是一次性产物（探测输出、日志、备份、截图中间物）
_*
# V3.0 例外：BrowserSkill 扩展里带下划线的 chunk 是运行时必需的，不能被 _* 吃掉
!bsk-extension/**/_*

# ---- 根目录下的界面截图（可重拍）----
/*.png

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/

# ---- 系统 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 运行时数据（下载台账 data/download_history.json 等，属本机状态，不入库）----
data/

# ---- 发布工作区补充（2026-10-01）----
# 旧 _* 规则会误伤包标记文件，必须显式豁免（否则 fresh git init 丢 __init__.py）
!__init__.py
!__main__.py
# 运行时配置（现迁移到 %LOCALAPPDATA%\MediaDownloader，本目录遗留副本含个人路径，不入库）
config.json
# 第三方工具检出与 WorkBuddy 任务上下文（按发行排除清单，绝不入库/入包）
gallery-dl/
.workbuddy/
.wbapp_*
build-probe/

# 1E：构建环境与产物
dist/
build/
.venv-build/
config.json
dist-archive/

# Inno Setup 可再生成输出（正式安装包文件保留本机，但不入 Git）
installer/output/
build_media/
dist_new/
