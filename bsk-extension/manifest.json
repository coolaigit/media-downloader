{
   "action": {
      "default_icon": {
         "128": "icon/logo.png",
         "16": "icon/logo.png",
         "32": "icon/logo.png",
         "48": "icon/logo.png"
      },
      "default_popup": "popup.html",
      "default_title": "browser-skill"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "all_frames": false,
      "js": [ "content-scripts/content.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_end"
   }, {
      "all_frames": false,
      "js": [ "content-scripts/long-screenshot-page.js" ],
      "matches": [ "http://*/*", "https://*/*" ],
      "run_at": "document_end"
   }, {
      "all_frames": true,
      "js": [ "content-scripts/record-frame.js" ],
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start"
   } ],
   "description": "Let AI agents use your logged-in browser in a separate Agent Window—without interrupting your work. Powered by the bsk CLI.",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "icon/logo.png",
      "16": "icon/logo.png",
      "32": "icon/logo.png",
      "48": "icon/logo.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "125",
   "name": "BrowserSkill",
   "permissions": [ "alarms", "activeTab", "debugger", "downloads", "idle", "notifications", "offscreen", "scripting", "tabs", "storage", "webNavigation", "windows" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "0.3.3"
}
